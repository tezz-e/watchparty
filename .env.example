# Watch Party Production & Development Environment Configuration

# Server Port (default: 3001)
PORT=3001

# Public URL when deployed across multiple networks (e.g., https://watchparty.yourdomain.com or https://your-app.onrender.com)
# When set, room invite links will use this origin so friends across networks can join.
AFTERGLOW_PUBLIC_URL=

# LAN IP address override for local network sessions (e.g., 192.168.1.5).
# If unset, the server automatically discovers the host's primary IPv4 LAN address.
AFTERGLOW_LAN_IP=

# Media directory path for local video assets
MEDIA_DIR=

# Client reconnect grace period in milliseconds (default: 15000)
RECONNECT_GRACE_MS=15000

# TMDB Read Access Token (Server-only secret for catalog seeding. Never prefix with VITE_).
TMDB_READ_ACCESS_TOKEN=

# Optional catalog seed region (e.g., US, NO, GB)
SEED_REGION=US

# Optional LiveKit WebRTC Screen Sharing Server Credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Client-side configuration (Vite)
# When hosting frontend separately (e.g., Vercel), set this to the backend server URL (e.g. https://your-backend.onrender.com)
VITE_SOCKET_URL=

# Development proxy target (defaults to http://localhost:3001)
VITE_BACKEND_URL=http://localhost:3001

# WebRTC Screen Sharing TURN Relay Configuration
# Peer-to-peer mesh WebRTC screen sharing includes default public STUN servers.
# When sharing across symmetric NAT or carrier-grade NAT (CGNAT, common on cellular/mobile data networks),
# direct P2P connections cannot connect without a TURN relay. Configure optional TURN server details below:
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=


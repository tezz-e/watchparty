# Server-only secret. Never prefix this with VITE_ or expose it to the browser.
TMDB_READ_ACCESS_TOKEN=replace-with-your-read-access-token

# Optional catalog seed region, for example US.
SEED_REGION=US

# Optional LiveKit server configuration. Leave unset when LiveKit is unavailable.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional public client override; by default the client uses the page's origin.
VITE_SOCKET_URL=

# Optional Vite development proxy target; defaults to http://localhost:3001.
VITE_BACKEND_URL=
